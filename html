<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Músicas Pedagógicas — Professora Fabiana</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --rosa:#e8a0b0;--rosa-claro:#fdf0f3;--rosa-medio:#f5c6d3;--rosa-escuro:#b5566e;
  --rosa-suave:#fbdde5;--rosa-text:#8a3a50;
  --verde:#2d9e7a;--verde-claro:#eaf7f2;--verde-escuro:#1a6b52;
  --roxo:#7c6dbf;--roxo-claro:#f0eefb;--roxo-escuro:#4a3d8a;
  --amber:#c4892a;--amber-claro:#fef4e4;--amber-escuro:#7a5210;
  --azul:#3a7fc1;--azul-claro:#eaf3fc;--azul-escuro:#1a4f82;
  --cinza:#6b6b6b;--cinza-claro:#f5f4f2;
  --bg:#fdf8f9;--surface:#ffffff;
  --border:rgba(232,160,176,0.25);--border-forte:rgba(232,160,176,0.45);
  --text:#2a1f23;--muted:#8a7a7e;
  --sombra:0 2px 20px rgba(181,86,110,0.07);
}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;position:relative;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background-image:radial-gradient(ellipse at 10% 20%,rgba(232,160,176,0.12) 0%,transparent 50%),radial-gradient(ellipse at 90% 80%,rgba(232,160,176,0.10) 0%,transparent 50%),radial-gradient(ellipse at 50% 50%,rgba(253,240,243,0.5) 0%,transparent 70%);pointer-events:none;z-index:0}
.floral-svg{position:fixed;pointer-events:none;z-index:0;opacity:0.12}
.floral-svg.tl{top:-30px;left:-30px;width:300px}
.floral-svg.br{bottom:-30px;right:-30px;width:260px;transform:rotate(180deg)}
.floral-svg.tr{top:10px;right:-10px;width:180px;opacity:0.07}
.floral-svg.bl{bottom:10px;left:-10px;width:160px;opacity:0.07;transform:scaleX(-1)}
header{position:relative;z-index:10;background:rgba(255,255,255,0.88);backdrop-filter:blur(12px);border-bottom:1px solid var(--border-forte);padding:1rem 1.5rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:12px}
.logo-icon{width:42px;height:42px;background:linear-gradient(135deg,#e8a0b0,#c96880);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 2px 8px rgba(181,86,110,0.3)}
.logo-icon svg{width:22px;height:22px;fill:white}
.logo h1{font-family:'Playfair Display',serif;font-size:20px;font-weight:500;color:var(--text);line-height:1.2}
.logo p{font-size:11px;color:var(--muted);margin-top:2px;font-weight:300}
.header-right{margin-left:auto;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.badge-bncc{font-size:10px;font-weight:500;padding:4px 12px;background:var(--rosa-claro);color:var(--rosa-text);border:1px solid var(--border-forte);border-radius:999px}
#btn-limpar-key{font-size:11px;color:var(--muted);background:none;border:1px solid var(--border-forte);cursor:pointer;padding:4px 10px;border-radius:999px;font-family:'Inter',sans-serif;transition:all .15s;display:none}
#btn-limpar-key:hover{background:var(--rosa-claro);color:var(--rosa-text)}
main{position:relative;z-index:5;max-width:1140px;margin:0 auto;padding:1.5rem 1rem}
#setup-panel{background:rgba(255,255,255,0.92);backdrop-filter:blur(8px);border:1px solid var(--border-forte);border-radius:20px;padding:2rem;max-width:680px;margin:2rem auto;box-shadow:var(--sombra)}
#setup-panel h2{font-family:'Playfair Display',serif;font-size:22px;font-weight:500;color:var(--text);margin-bottom:10px}
#setup-panel .sub{font-size:13px;color:var(--muted);line-height:1.7;margin-bottom:1.25rem}
.steps{background:var(--rosa-claro);border:1px solid var(--border-forte);border-radius:12px;padding:1rem 1.25rem;margin-bottom:1.25rem}
.steps ol{font-size:12.5px;color:var(--text);line-height:2;padding-left:1.25rem}
.steps ol a{color:var(--rosa-escuro);text-decoration:none;font-weight:500}
.steps ol a:hover{text-decoration:underline}
.steps ol code{font-size:11px;background:white;padding:1px 6px;border-radius:4px;border:1px solid var(--border-forte);color:var(--rosa-text)}
.cota-note{font-size:12px;color:var(--muted);background:var(--verde-claro);border:1px solid rgba(45,158,122,0.2);border-radius:8px;padding:8px 12px;margin-bottom:1.25rem}
.key-row{display:flex;gap:8px;flex-wrap:wrap}
#api-key-input{flex:1;min-width:220px;font-family:'Inter',sans-serif;font-size:13px;padding:10px 14px;border:1px solid var(--border-forte);border-radius:10px;color:var(--text);background:white;outline:none;transition:border-color .15s}
#api-key-input:focus{border-color:var(--rosa)}
#btn-salvar-key{font-family:'Inter',sans-serif;font-size:13px;font-weight:500;padding:10px 22px;background:linear-gradient(135deg,#e8a0b0,#c96880);color:white;border:none;border-radius:10px;cursor:pointer;box-shadow:0 2px 8px rgba(181,86,110,0.25);transition:opacity .15s;white-space:nowrap}
#btn-salvar-key:hover{opacity:.88}
#key-status{font-size:12px;margin-top:8px}
#key-status.ok{color:var(--verde)}
#key-status.err{color:#c0392b}
#app{display:none}
.search-wrap{background:rgba(255,255,255,0.92);backdrop-filter:blur(8px);border:1px solid var(--border-forte);border-radius:16px;padding:1rem 1.25rem;margin-bottom:1rem;display:flex;align-items:center;gap:10px;box-shadow:var(--sombra)}
.search-wrap svg{color:var(--rosa);flex-shrink:0}
#q{flex:1;border:none;background:transparent;font-family:'Inter',sans-serif;font-size:15px;color:var(--text);outline:none}
#q::placeholder{color:#c0b0b4}
#btn-buscar{font-family:'Inter',sans-serif;font-size:13px;font-weight:500;padding:9px 22px;background:linear-gradient(135deg,#e8a0b0,#c96880);color:white;border:none;border-radius:10px;cursor:pointer;box-shadow:0 2px 8px rgba(181,86,110,0.25);transition:opacity .15s;white-space:nowrap}
#btn-buscar:hover{opacity:.88}
#btn-buscar:disabled{opacity:.4;cursor:not-allowed}
.filters{background:rgba(255,255,255,0.88);backdrop-filter:blur(8px);border:1px solid var(--border-forte);border-radius:16px;padding:1rem 1.25rem;margin-bottom:1rem;display:flex;gap:1.25rem;flex-wrap:wrap;box-shadow:var(--sombra)}
.fg{display:flex;flex-direction:column;gap:6px;min-width:150px}
.fg-label{font-size:10px;font-weight:500;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}
.pills{display:flex;flex-wrap:wrap;gap:5px}
.pill{font-size:11px;font-weight:400;padding:5px 12px;border-radius:999px;border:1px solid var(--border-forte);background:white;color:var(--muted);cursor:pointer;transition:all .12s;user-select:none}
.pill:hover{background:var(--rosa-claro);color:var(--rosa-text)}
.pill.on-EO{background:#fce8ec;color:#8a2a3e;border-color:#e8a0b0}
.pill.on-CG{background:var(--roxo-claro);color:var(--roxo-escuro);border-color:#b0a5e0}
.pill.on-TS{background:var(--amber-claro);color:var(--amber-escuro);border-color:#e8c07a}
.pill.on-EF{background:var(--verde-claro);color:var(--verde-escuro);border-color:#7dd4ba}
.pill.on-ET{background:var(--azul-claro);color:var(--azul-escuro);border-color:#90bde8}
.pill.on-dir{background:var(--rosa-claro);color:var(--rosa-text);border-color:var(--rosa)}
.pill.on-abord{background:var(--roxo-claro);color:var(--roxo-escuro);border-color:#b0a5e0}
.status-bar{font-size:12px;color:var(--muted);margin-bottom:.75rem;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.status-bar button{font-size:11px;color:var(--muted);background:none;border:1px solid var(--border-forte);cursor:pointer;padding:3px 10px;border-radius:999px;font-family:'Inter',sans-serif;transition:all .12s}
.status-bar button:hover{background:var(--rosa-claro);color:var(--rosa-text)}
#loader{display:none;text-align:center;padding:3rem;color:var(--muted);font-size:14px}
.spinner{width:32px;height:32px;border:2px solid var(--rosa-medio);border-top-color:var(--rosa-escuro);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 14px}
@keyframes spin{to{transform:rotate(360deg)}}
#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:1rem}
.card{background:rgba(255,255,255,0.95);border:1px solid var(--border-forte);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:all .2s;box-shadow:var(--sombra)}
.card:hover{border-color:var(--rosa);box-shadow:0 4px 24px rgba(181,86,110,0.13);transform:translateY(-2px)}
.thumb-wrap{position:relative;padding-top:56.25%;background:#f0d0d8;flex-shrink:0;cursor:pointer}
.thumb-wrap img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.play-btn{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.15);transition:background .15s}
.play-btn:hover{background:rgba(0,0,0,0.32)}
.play-btn svg{width:46px;height:46px;fill:white;filter:drop-shadow(0 1px 4px rgba(0,0,0,.4))}
.dur-badge{position:absolute;bottom:7px;right:7px;background:rgba(0,0,0,.72);color:white;font-size:11px;font-weight:500;padding:2px 7px;border-radius:5px}
.card-body{padding:1rem;display:flex;flex-direction:column;gap:8px;flex:1}
.card-title{font-family:'Playfair Display',serif;font-size:14px;font-weight:500;line-height:1.35;color:var(--text)}
.card-channel{font-size:11px;color:var(--muted);font-weight:300}
.card-badges{display:flex;flex-wrap:wrap;gap:4px}
.bdg{font-size:10px;font-weight:500;padding:3px 8px;border-radius:999px}
.bdg-EO{background:#fce8ec;color:#8a2a3e}
.bdg-CG{background:var(--roxo-claro);color:var(--roxo-escuro)}
.bdg-TS{background:var(--amber-claro);color:var(--amber-escuro)}
.bdg-EF{background:var(--verde-claro);color:var(--verde-escuro)}
.bdg-ET{background:var(--azul-claro);color:var(--azul-escuro)}
.bdg-dir{background:var(--cinza-claro);color:#3a3a3a}
.bdg-ok{background:var(--verde-claro);color:var(--verde-escuro)}
.bdg-cod{background:var(--rosa-claro);color:var(--rosa-text);font-family:monospace}
.card-actions{display:flex;gap:6px;margin-top:auto;padding-top:4px}
.btn-yt{display:inline-flex;align-items:center;gap:5px;font-family:'Inter',sans-serif;font-size:11px;font-weight:500;padding:7px 13px;border-radius:9px;border:none;background:#FF0000;color:white;cursor:pointer;text-decoration:none;transition:opacity .12s;flex:1;justify-content:center}
.btn-yt:hover{opacity:.85}
.btn-yt svg{width:13px;height:13px;fill:white;flex-shrink:0}
.btn-copy{display:inline-flex;align-items:center;gap:5px;font-family:'Inter',sans-serif;font-size:11px;font-weight:400;padding:7px 11px;border-radius:9px;border:1px solid var(--border-forte);background:white;color:var(--muted);cursor:pointer;text-decoration:none;transition:all .12s}
.btn-copy:hover{background:var(--rosa-claro);color:var(--rosa-text)}
.card-warn{font-size:10px;color:var(--amber-escuro);background:var(--amber-claro);padding:4px 8px;border-radius:6px;line-height:1.4}
.msg-box{grid-column:1/-1;text-align:center;padding:3rem;color:var(--muted);font-size:14px}
.msg-box strong{display:block;font-family:'Playfair Display',serif;font-size:18px;color:var(--text);margin-bottom:6px}
#pag{display:flex;justify-content:center;gap:6px;margin-top:1.5rem;flex-wrap:wrap}
.pag-btn{font-family:'Inter',sans-serif;font-size:12px;padding:7px 14px;border:1px solid var(--border-forte);border-radius:9px;background:white;color:var(--text);cursor:pointer;transition:all .12s}
.pag-btn:hover{background:var(--rosa-claro);color:var(--rosa-text);border-color:var(--rosa)}
.pag-btn.active{background:linear-gradient(135deg,#e8a0b0,#c96880);color:white;border-color:transparent}
footer{position:relative;z-index:5;text-align:center;padding:1.5rem;font-size:11px;color:var(--muted);border-top:1px solid var(--border);margin-top:3rem;font-weight:300}
@media(max-width:600px){
  header{padding:.9rem 1rem}
  .logo h1{font-size:17px}
  main{padding:1rem .75rem}
  .search-wrap{flex-wrap:wrap}
  #q{width:100%}
  #btn-buscar{width:100%}
  #grid{grid-template-columns:1fr}
  #setup-panel{padding:1.25rem;margin:1rem 0}
  .floral-svg.tl{width:180px}
  .floral-svg.br{width:160px}
}
</style>
</head>
<body>

<svg class="floral-svg tl" viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">
  <g fill="#e8a0b0">
    <ellipse cx="80" cy="80" rx="55" ry="20" transform="rotate(0 80 80)"/>
    <ellipse cx="80" cy="80" rx="55" ry="20" transform="rotate(45 80 80)"/>
