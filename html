    <ellipse cx="80" cy="80" rx="55" ry="20" transform="rotate(135 80 80)"/>
    <circle cx="80" cy="80" r="13" fill="#fdf0f3"/>
    <ellipse cx="190" cy="170" rx="42" ry="15" transform="rotate(20 190 170)"/>
