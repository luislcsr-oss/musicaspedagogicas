<svg class="floral-svg tr" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <g fill="#e8a0b0">
    <ellipse cx="100" cy="100" rx="45" ry="16" transform="rotate(0 100 100)"/>
    <ellipse cx="100" cy="100" rx="45" ry="16" transform="rotate(60 100 100)"/>
