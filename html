<script>
const CAMPOS={EO:{nome:"O eu, o outro e o nós",codigos:["EI03EO01","EI03EO02","EI03EO03","EI03EO04","EI03EO05","EI03EO06","EI03EO07"]},CG:{nome:"Corpo, gestos e movimentos",codigos:["EI03CG01","EI03CG02","EI03CG03","EI03CG04","EI03CG05"]},TS:{nome:"Traços, sons, cores e formas",codigos:["EI03TS01","EI03TS02","EI03TS03","EI03TS04","EI03TS05"]},EF:{nome:"Escuta, fala, pensamento e imaginação",codigos:["EI03EF01","EI03EF02","EI03EF03","EI03EF04","EI03EF05","EI03EF06","EI03EF07","EI03EF08","EI03EF09"]},ET:{nome:"Espaços, tempos, quantidades, relações e transformações",codigos:["EI03ET01","EI03ET02","EI03ET03","EI03ET04","EI03ET05","EI03ET06","EI03ET07"]}};
const QC={EO:["música infantil identidade cooperação roda educação","canção infantil amizade convivência escola criança","música brincadeira coletiva criança educação infantil brasileira","canção folclore roda criança brasileira tradicional","música sentimentos emoções criança 4 anos escola"],CG:["música movimento corporal criança educação infantil","canção dança gestos infantil escola brasileira","música brincadeira movimento criança pequena 4 anos","canção ritmo corporal educação infantil Brasil","música coordenação motora infantil pedagógica"],TS:["música artes visuais infantil escola brasileira","canção cores criatividade educação infantil","música sons instrumentos criança pequena escola","canção folclore tradição oral infantil brasileira","música expressão artística educação infantil pedagógica"],EF:["música contação histórias infantil brasileira","canção imaginação linguagem criança educação","música poesia infantil brasileira qualidade pedagógica","canção rima vocabulário educação infantil","música narrativa faz de conta infantil 4 anos"],ET:["música números contagem infantil educação brasileira","canção natureza meio ambiente criança escola","música sequência lógica educação infantil","canção tempo rotina criança pequena escola","música espaço orientação infantil pedagógica"]};
const QA={Waldorf:["música Waldorf educação infantil criança natureza","canção ritmo natureza educação infantil steiner","música contação histórias infantil natureza ritmo"],Montessori:["música autonomia criança Montessori educação infantil","canção criança pequena aprender fazendo escola","música consciência infantil desenvolvimento Montessori"],Piaget:["música jogo simbólico educação infantil faz de conta","canção brincadeira faz de conta criança 4 anos","música desenvolvimento infantil imaginação 4 anos escola"]};
const QB=["Palavra Cantada música educação infantil","Bia Bedran música infantil","Toquinho música infantil clássica","Vinícius de Moraes música infantil criança","Tia Má música infantil escola","música folclore brasileiro roda criança educação","canção educação infantil qualidade pedagógica","música pedagógica criança 4 anos educação infantil","canção infantil brasileira clássica educação","música brincadeira infantil tradicional brasileira escola"];
const AOK=["palavra cantada","bia bedran","tia má","marta prudente","toquinho","vinícius de moraes","vinicius de moraes","caetano veloso","gilberto gil","adriana calcanhotto","arnaldo antunes","ivan lins","djavan","chico buarque","milton nascimento","dorival caymmi","luiz gonzaga","elza soares","maria bethânia","gal costa","nana caymmi","alceu valença","lenine","zé ramalho","gonzaguinha","fagner","belchior"];
const VET=["funk","pagode","sertanejo universitário","axé","brega","piseiro","reggaeton","trap","mc ","twerk","sensual","adulto","evangélico","evangélica","gospel","oração","missa","culto","bíblia","jesus infantil evangelismo","comercial","propaganda","publicidade","slime","unboxing","challenge","gaming","gameplay","cocomelon","morphle","superhero","violência","terror","namoro infantil","beijo infantil","romance criança"];
const CVet=["canal kids","videokids","evang","gospel kids","ministério infantil","pregação criança"];
const COK=["palavra cantada","bia bedran","tia má","toquinho oficial","tv escola","mec","nova escola","sesc","funarte","philharmonia","orquestra","instituto","cultural","museu"];

function parseDur(iso){const m=iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);if(!m)return 999;return(parseInt(m[1]||0)*60)+parseInt(m[2]||0)+parseInt(m[3]||0)/60}
function fmtDur(min){const m=Math.floor(min),s=Math.round((min-m)*60);return m+":"+String(s).padStart(2,"0")}
function scoreVideo(item){
  const t=(item.snippet.title||"").toLowerCase(),ch=(item.snippet.channelTitle||"").toLowerCase(),d=(item.snippet.description||"").toLowerCase(),f=t+" "+ch+" "+d;
  let score=0,warns=[];
  for(const v of VET){if(f.includes(v))return{score:-999,warns:["vetado"]}}
  for(const c of CVet){if(ch.includes(c))return{score:-999,warns:["canal vetado"]}}
  for(const a of AOK){if(f.includes(a)){score+=40;break}}
  for(const c of COK){if(ch.includes(c)){score+=30;break}}
  for(const x of["educação infantil","música infantil","canção infantil","folclore","roda","pedagógico","pedagógica","escola","aprendizagem","brincadeira","tradição oral","clássico","poesia","ritmo","expressão"]){if(f.includes(x))score+=7}
  for(const x of["1 hora","2 horas","3 horas","compilation","mix completo","episódios","desenho","cartoon","animação 3d","cgi","vlogs","reação"]){if(f.includes(x)){score-=15;warns.push("compilação")}}
  if(t.length<8)score-=10;
  return{score,warns};
}
function inferCampo(t,d){const f=(t+" "+d).toLowerCase();if(/identidade|coopera|amizade|conviv|roda|emoção|sentiment|família|nós|grupo/.test(f))return"EO";if(/movimento|corpo|dança|gesto|coordena|motora|equilíbrio/.test(f))return"CG";if(/cor|artes|pintura|som|instrumento|ritmo|folclore|criatividade|expressão/.test(f))return"TS";if(/história|imagina|poesia|palavra|fala|contar|narrativa|rima|vocabulário|escuta/.test(f))return"EF";if(/número|contar|natureza|tempo|espaço|quantidade|transforma|água|planta|animal/.test(f))return"ET";return null}
function inferDir(c){return{EO:"Conviver",CG:"Brincar",TS:"Expressar",EF:"Explorar",ET:"Explorar"}[c]||"Participar"}
function inferCod(c){if(!c)return null;const a=CAMPOS[c]?.codigos;return a?a[0]:null}

let KEY="",filtros={campo:null,dir:null,abord:null},cards=[],pag=1;
const PPG=12;

function salvarChave(){
  const k=document.getElementById("api-key-input").value.trim();
  if(!k.startsWith("AIza")||k.length<30){const s=document.getElementById("key-status");s.textContent="Chave inválida. Deve começar com AIza.";s.className="err";return}
  KEY=k;localStorage.setItem("yt_key_fab",k);
  const s=document.getElementById("key-status");s.textContent="Chave salva!";s.className="ok";
  setTimeout(ativar,500);
}
function ativar(){
  document.getElementById("setup-panel").style.display="none";
  document.getElementById("app").style.display="block";
  document.getElementById("btn-limpar-key").style.display="inline-flex";
  executar();
}
function limparChave(){
  localStorage.removeItem("yt_key_fab");KEY="";
  document.getElementById("setup-panel").style.display="block";
  document.getElementById("app").style.display="none";
  document.getElementById("btn-limpar-key").style.display="none";
  document.getElementById("api-key-input").value="";
  document.getElementById("key-status").textContent="";
}
function montarQ(){
  const txt=document.getElementById("q").value.trim();
  let qs=filtros.campo?QC[filtros.campo].slice():filtros.abord?QA[filtros.abord].slice():QB.slice();
  if(txt){if(filtros.campo||filtros.abord)qs=qs.map(q=>q+" "+txt);else qs=[txt+" música infantil educativa educação infantil",txt+" canção criança escola educação infantil",...qs.slice(0,3)]}
  return qs.slice(0,5);
}
async function fetchYT(q){
  const p=new URLSearchParams({part:"snippet",q,type:"video",videoDuration:"short",relevanceLanguage:"pt",regionCode:"BR",safeSearch:"strict",maxResults:"15",key:KEY});
  const r=await fetch("https://www.googleapis.com/youtube/v3/search?"+p);
  if(!r.ok){const e=await r.json();throw new Error(e.error?.message||"Erro na API")}
  return r.json();
}
async function fetchDets(ids){
  const p=new URLSearchParams({part:"contentDetails",id:ids.join(","),key:KEY});
  const r=await fetch("https://www.googleapis.com/youtube/v3/videos?"+p);
  if(!r.ok)return{};
  const d=await r.json();const m={};for(const i of(d.items||[]))m[i.id]=i;return m;
}
function buscar(){pag=1;executar()}
async function executar(){
  if(!KEY)return;
  const qs=montarQ();
  document.getElementById("loader").style.display="block";
  document.getElementById("grid").innerHTML="";
  document.getElementById("pag").innerHTML="";
  document.getElementById("status-bar").style.display="none";
  document.getElementById("btn-buscar").disabled=true;
  cards=[];const titulos=new Set();
  try{
    const im={};
    for(const q of qs){try{const d=await fetchYT(q);for(const i of(d.items||[])){const id=i.id.videoId;if(id&&!im[id])im[id]=i}}catch(e){console.warn("q falhou:",q)}}
    const ids=Object.keys(im);
    if(!ids.length)throw new Error("Nenhum resultado. Tente outros filtros.");
    const dets={};
    for(let i=0;i<ids.length;i+=50)Object.assign(dets,await fetchDets(ids.slice(i,i+50)));
    const cands=[];
    for(const id of ids){
      const item=im[id];const tl=item.snippet.title.toLowerCase();
      let dup=false;for(const t of titulos){if(tl.includes(t.slice(0,14))||t.includes(tl.slice(0,14))){dup=true;break}}
      if(dup)continue;titulos.add(tl);
      const det=dets[id];let dur=5;
      if(det?.contentDetails?.duration)dur=parseDur(det.contentDetails.duration);
      if(dur>12||dur<0.4)continue;
      const{score,warns}=scoreVideo(item);if(score<=-999)continue;
      const campo=filtros.campo||inferCampo(item.snippet.title,item.snippet.description);
      if(filtros.dir&&inferDir(campo)!==filtros.dir)continue;
      cands.push({item,id,score,warns,dur,campo});
    }
    cands.sort((a,b)=>b.score-a.score);
    cards=cands.map(({item,id,warns,dur,campo})=>{
      const title=item.snippet.title,channel=item.snippet.channelTitle;
      const thumb=item.snippet.thumbnails?.medium?.url||item.snippet.thumbnails?.default?.url;
      const ytUrl="https://www.youtube.com/watch?v="+id;
      const isOk=AOK.some(a=>(title+channel).toLowerCase().includes(a));
      return{title,channel,thumb,dur,campo,direito:inferDir(campo),codigo:inferCod(campo),ytUrl,warns,isOk};
    });
    document.getElementById("loader").style.display="none";
    document.getElementById("btn-buscar").disabled=false;
    renderPag();
    const sb=document.getElementById("status-bar");sb.style.display="flex";
    document.getElementById("status-txt").textContent=cards.length+" músicas encontradas e filtradas";
    const at=[];if(filtros.campo)at.push(CAMPOS[filtros.campo].nome);if(filtros.dir)at.push(filtros.dir);if(filtros.abord)at.push(filtros.abord);
    document.getElementById("filtros-ativos").textContent=at.length?"· "+at.join(", "):"";
  }catch(e){
    document.getElementById("loader").style.display="none";
    document.getElementById("btn-buscar").disabled=false;
    document.getElementById("grid").innerHTML='<div class="msg-box"><strong>Ops!</strong>'+e.message+'</div>';
  }
}
function renderPag(){
  const ini=(pag-1)*PPG,pg=cards.slice(ini,ini+PPG),grid=document.getElementById("grid");
  if(!pg.length){grid.innerHTML='<div class="msg-box"><strong>Nenhum resultado</strong>Tente outros filtros.</div>';return}
  grid.innerHTML=pg.map(c=>{
    const cn=c.campo?CAMPOS[c.campo]?.nome:null;
    const al=c.warns.length&&c.warns[0]!=="vetado"?'<div class="card-warn">Verifique antes de usar em sala: '+c.warns.join(", ")+'</div>':"";
    const esc=c.ytUrl.replace(/'/g,"\\'");
    return'<div class="card"><div class="thumb-wrap" onclick="window.open(\''+esc+'\',\'_blank\')"><img src="'+c.thumb+'" alt="" loading="lazy"><div class="play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div><span class="dur-badge">'+fmtDur(c.dur)+'</span></div><div class="card-body"><div class="card-title">'+c.title+'</div><div class="card-channel">'+c.channel+'</div><div class="card-badges">'+(cn?'<span class="bdg bdg-'+c.campo+'">'+cn+'</span>':"")+(c.codigo?'<span class="bdg bdg-cod">'+c.codigo+'…</span>':"")+'<span class="bdg bdg-dir">'+c.direito+'</span>'+(c.isOk?'<span class="bdg bdg-ok">Artista curado</span>':"")+'</div>'+al+'<div class="card-actions"><a class="btn-yt" href="'+c.ytUrl+'" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.47 3.5 12 3.5 12 3.5s-7.47 0-9.38.55A3.02 3.02 0 0 0 .5 6.19C0 8.12 0 12 0 12s0 3.88.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.91.55 9.38.55 9.38.55s7.47 0 9.38-.55a3.02 3.02 0 0 0 2.12-2.14C24 15.88 24 12 24 12s0-3.88-.5-5.81zM9.75 15.02V8.98L15.83 12l-6.08 3.02z"/></svg> Abrir no YouTube</a><button class="btn-copy" onclick="navigator.clipboard.writeText(\''+esc+'\');this.textContent=\'Copiado!\'">Link</button></div></div></div>';
  }).join("");
  renderPaginacao();
}
function renderPaginacao(){
  const tot=Math.ceil(cards.length/PPG);if(tot<=1){document.getElementById("pag").innerHTML="";return}
  let h="";
  if(pag>1)h+='<button class="pag-btn" onclick="irPag('+(pag-1)+')">← Anterior</button>';
  for(let i=1;i<=tot;i++)h+='<button class="pag-btn '+(i===pag?"active":"")+'" onclick="irPag('+i+')">'+i+'</button>';
  if(pag<tot)h+='<button class="pag-btn" onclick="irPag('+(pag+1)+')">Próxima →</button>';
  document.getElementById("pag").innerHTML=h;
}
function irPag(n){pag=n;renderPag();window.scrollTo({top:0,behavior:"smooth"})}
function limparFiltros(){filtros={campo:null,dir:null,abord:null};document.querySelectorAll(".pill").forEach(p=>p.className="pill");document.getElementById("q").value="";buscar()}
document.querySelectorAll(".pill").forEach(p=>{
  p.addEventListener("click",()=>{
    const g=p.dataset.g,v=p.dataset.v,era=filtros[g]===v;
    filtros[g]=era?null:v;
    document.querySelectorAll('.pill[data-g="'+g+'"]').forEach(x=>x.className="pill");
    if(!era)p.classList.add("on-"+(g==="campo"?v:g));
    buscar();
  });
});
window.addEventListener("load",()=>{const k=localStorage.getItem("yt_key_fab");if(k){KEY=k;document.getElementById("api-key-input").value=k;ativar()}});
</script>
